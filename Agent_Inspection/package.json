{
  "name": "waystation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": { "node": ">=22.20.0" },
  "description": "Waystation: see and steer every coding agent on this machine (Claude Code, Codex and more) from one local dashboard. Intercept tool calls, instruct, stop, delegate and run mixed agent teams.",
  "bin": {
    "waystation": "scripts/waystation.mjs"
  },
  "scripts": {
    "desktop": "node scripts/desktop.mjs",
    "desktop:verify": "node scripts/verify-desktop.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "export:source": "node scripts/export-source.mjs",
    "start": "node scripts/waystation.mjs",
    "serve": "vite build && tsx daemon/index.ts",
    "daemon": "tsx daemon/index.ts",
    "daemon:dev": "tsx daemon/index.ts --dev",
    "dev:web": "vite",
    "open": "node scripts/open.mjs",
    "attach": "tsx daemon/cli/attach.ts",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "nodemailer": "^10.0.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "44.7.0",
    "framer-motion": "^13.5.0",
    "playwright-core": "1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
